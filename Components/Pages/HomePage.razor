@using Umbraco.Cms.Web.Common.PublishedModels

<section class="home">
    <h1>@Model.PageTitle</h1>

    @if (!string.IsNullOrWhiteSpace(Model.IntroString))
    {
        <p>@Model.IntroString</p>
    }

    <p>
        <a class="btn btn-primary" href="/pokemon">Browse Pokémon</a>
    </p>
</section>

@code {
    [Parameter]
    public Home Model { get; set; }
}
