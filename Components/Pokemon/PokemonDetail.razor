@using PokemonUmbraco.Models.External
@using PokemonUmbraco.Services.Interfaces
@inject IPokeApiService PokeApi

@if (Pokemon == null)
{
    <p>Loading @Name...</p>
}
else
{
    <div>
        <h2 class="text-capitalize">@Pokemon.Name</h2>

        @if (Pokemon != null)
        {
            var images = new List<string?>
    {
        Pokemon.Sprites.Other?.OfficialArtwork?.FrontDefault,
        Pokemon.Sprites.FrontDefault,
        Pokemon.Sprites.BackDefault,
        Pokemon.Sprites.FrontShiny,
        Pokemon.Sprites.BackShiny
    }
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();

            <div id="pokemonCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                <div class="carousel-inner">

                    @for (int i = 0; i < images.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="d-flex justify-content-center align-items-center carousel-min-height">
                                <img src="@images[i]"
                                     alt="@Pokemon.Name"
                                     class="img-fluid"
                                     style="max-height: 300px;" />
                            </div>
                        </div>
                    }

                
                        <button class="carousel-control-prev" type="button" data-bs-target="#pokemonCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>

                        <button class="carousel-control-next" type="button" data-bs-target="#pokemonCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                  

                </div>

            
            </div>
        }




        <h4>Types</h4>
        <ul>
            @foreach (var t in Pokemon.Types)
            {
                <li class="text-capitalize">@t.Type.Name</li>
            }
        </ul>

        <h4>Abilities</h4>
        <ul>
            @foreach (var a in Pokemon.Abilities)
            {
                <li class="text-capitalize">@a.Ability.Name</li>
            }
        </ul>

        <h4>Stats</h4>
        <ul>
            @foreach (var s in Pokemon.Stats)
            {
                <li class="text-capitalize">
                    <strong>@s.Stat.Name:</strong> @s.BaseStat
                </li>
            }
        </ul>

        <p>
            <strong>Height:</strong> @Pokemon.Height
            <br />
            <strong>Weight:</strong> @Pokemon.Weight
        </p>
    </div>
    <style>
        .carousel-min-height {
            min-height: 300px;
            align-items: center;
        }

        .carousel-control-prev-icon,
        .carousel-control-next-icon {
            filter: invert(1); /* makes the white arrow black */
            background-color: rgba(0, 0, 0, 0.4); /* dark circle */
            border-radius: 50%;
            padding: 20px;
        }
    </style>

}


@code {
    [Parameter] public string Name { get; set; }

    private PokemonDto Pokemon;

    protected override async Task OnInitializedAsync()
    {
        Pokemon = await PokeApi.GetPokemonAsync(Name);
    }
}

