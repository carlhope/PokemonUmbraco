{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "c9c06975-1e68-4fdf-9424-2291e7e09f4c"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeAuto",
        "ModelsDirectory": "~/Models"
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=localhost\\SQLEXPRESS;Database=PokemonUmbraco;Trusted_Connection=True;TrustServerCertificate=True"
  }

  //"ConnectionStrings": {
  //  "umbracoDbDSN": "Data Source=|DataDirectory|/PokemonUmbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
  //  "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  //}
}