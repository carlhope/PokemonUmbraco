@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Contact>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "~/Views/layout.cshtml";
	var block = Model.ContactDetails;
	var details = block != null ? (ContactDetails)block.Content : null;

}
<section class="contact-page">

	<h1>@Model.Name</h1>

	@* Contact Details *@
	@if (details != null)
	{
		<div class="contact-details">

			@if (!string.IsNullOrWhiteSpace(details.Company))
			{
				<p class="company">@details.Company</p>
			}

			<p>@details.AddressLine1</p>

			@if (!string.IsNullOrWhiteSpace(details.AddressLine2))
			{
				<p>@details.AddressLine2</p>
			}

			@if (!string.IsNullOrWhiteSpace(details.AddressLine3))
			{
				<p>@details.AddressLine3</p>
			}

			<p>@details.City</p>

			@if (!string.IsNullOrWhiteSpace(details.County))
			{
				<p>@details.County</p>
			}

			<p><strong>Phone:</strong> @details.PhoneNumber</p>

			<p>
				<strong>Email:</strong>
				<a href="mailto:@details.Email">@details.Email</a>
			</p>

		</div>
	}

	@* Contact Form *@
	@if (Model.ContactForm.HasValue)
	{
		<div class="contact-form">
			@await Component.InvokeAsync("RenderForm", new { formId = Model.ContactForm, 
				theme = "basic", 
				includeScripts = true })

		</div>
		<umb-forms-render-scripts theme="basic" />
	}

</section>
