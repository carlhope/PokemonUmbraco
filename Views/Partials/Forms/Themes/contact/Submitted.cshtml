@model Umbraco.Forms.Web.Models.FormViewModel


@if (Model.MessageOnSubmitIsHtml)
{
    <div  class="my-form-success">
    <div class="umbraco-forms-submitmessage-html">
        @Model.GetMessageOnSubmit() from the html version
    </div>
    </div>
}
else
{
    <div class="my-form-success">
        <span class="umbraco-forms-submitmessage">
            @Model.GetMessageOnSubmit() from the non html version
        </span>
    </div>
}
@await Html.PartialAsync("Forms/Themes/basic/ScrollToFormScript")

<style>
    .umbraco-forms-submitmessage, .umbraco-forms-submitmessage-html {
        background-color: #d1e7dd; /* Bootstrap success background */
        border: 1px solid #badbcc; /* subtle border */
        color: #0f5132; /* success text */
        padding: 1rem 1.25rem;
        border-radius: .25rem;
        margin-top: 1.5rem;
        font-size: 1.1rem;
        line-height: 1.5;
        text-align: center;
    }
</style>